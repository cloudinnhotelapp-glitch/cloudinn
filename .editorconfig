# Keeps indentation and line endings consistent across editors.
root = true

# Default style for every file.
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Markdown uses trailing spaces for line breaks, so keep them.
[*.md]
trim_trailing_whitespace = false
