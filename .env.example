# Example environment settings. Copy to ".env" in this folder and fill in real local values.
# Placeholders only: never put real credentials in this file.

# --- Runtime mode ---
# Use "development" locally; "production" turns on Secure cookies and stricter defaults.
NODE_ENV=development

# --- API server ---
# Port the NestJS API listens on locally.
API_PORT=4000
# The one browser origin allowed to call the API (the Next.js app).
FRONTEND_ORIGIN=http://localhost:3000
# Shows Swagger docs at /api/docs when true; keep false in production.
SWAGGER_ENABLED=true

# --- Web app ---
# Server-side address the Next.js app uses to proxy /api/v1 requests to the API.
API_INTERNAL_URL=http://localhost:4000

# --- PostgreSQL ---
# Connection string for the local database (fill in your own user, password, and database name).
DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_DB_NAME?schema=public
# Separate database used only by automated tests (concurrency tests run against it).
TEST_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_TEST_DB_NAME?schema=public
# Empty, pre-created database that "prisma migrate dev" uses to verify migrations (never holds real data).
SHADOW_DATABASE_URL=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/YOUR_SHADOW_DB_NAME?schema=public

# --- Sessions ---
# Long random secret used to derive CSRF tokens; at least 64 random characters (required).
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET
# Minutes of inactivity before a session expires.
SESSION_IDLE_TIMEOUT_MINUTES=60
# Maximum session lifetime in hours, regardless of activity.
SESSION_ABSOLUTE_TIMEOUT_HOURS=12
# Login attempts allowed per IP address per minute (accounts also lock for 15 minutes after 5 wrong passwords).
LOGIN_RATE_LIMIT_PER_MINUTE=10

# --- File storage for guest ID documents (used from Phase 6) ---
# "local" stores files on disk for development; "s3" uses a private S3-compatible bucket.
STORAGE_DRIVER=local
# Folder used by the local development storage adapter.
STORAGE_LOCAL_PATH=./storage
# Private S3-compatible bucket settings (leave as placeholders until production storage exists).
S3_ENDPOINT=
S3_REGION=YOUR_REGION
S3_BUCKET=YOUR_PRIVATE_BUCKET
S3_ACCESS_KEY_ID=YOUR_ACCESS_KEY_ID
S3_SECRET_ACCESS_KEY=YOUR_SECRET_ACCESS_KEY
# Lifetime of presigned download/upload links, in seconds.
S3_PRESIGNED_URL_TTL_SECONDS=300

# --- First Super Admin seed ---
# "pnpm db:seed" creates this account once (never overwrites it); the password must be changed on first login.
# Password rules: 12-128 characters, not a common password, must not contain the email name.
SUPER_ADMIN_SEED_EMAIL=superadmin@example.com
SUPER_ADMIN_SEED_PASSWORD=REPLACE_WITH_A_STRONG_TEMPORARY_PASSWORD
SUPER_ADMIN_SEED_NAME=Platform Super Admin
